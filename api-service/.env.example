# Строка подключения к БД. Хост localhost — потому что приложение пока запускается
# на вашем компьютере, а порт 5432 проброшен из контейнера (см. docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://you_can_book:you_can_book@localhost:5433/you_can_book_db
# true — печатать в консоль все SQL-запросы, которые генерирует SQLAlchemy
SQL_ECHO=false
